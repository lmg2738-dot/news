# 기본: config.json (텔레그램·선택적 github_token)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NEWS_KEYWORDS=CJ

# cron-job.org 백업용 (Vercel 환경 변수). 없으면 /api/cron 공개 호출됨
CRON_SECRET=random_long_string
APP_URL=https://news-iota-peach.vercel.app

# 저장 (택1) — Vercel /api/cron 에서 저장하려면 필수
# ① Upstash Redis (Vercel 대시보드 → Storage → Upstash Redis → Connect)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ② GitHub API로 data/news-state.json 커밋 (config.json github_token 과 동일 가능)
GITHUB_TOKEN=
GITHUB_REPOSITORY=lmg2738-dot/news
STATE_BRANCH=main
# STATE_JSON_URL=
