# 기본: 저장소 루트 config.json 사용 (커밋됨)
# 환경 변수가 있으면 config.json보다 우선합니다.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 쉼표로 여러 키워드 (기본: CJ)
NEWS_KEYWORDS=CJ

# /api/cron HTTP 호출 보호 (GitHub Actions·batch:remote)
CRON_SECRET=random_long_string

# GitHub Actions Secrets — 배포된 사이트 URL (슬래시 없이)
# APP_URL=https://your-project.vercel.app

# batch:remote, Vercel 배치 트리거용
APP_URL=

# Storage → Blob 연결 시 Vercel이 자동 주입
BLOB_READ_WRITE_TOKEN=
